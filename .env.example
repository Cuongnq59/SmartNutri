# SMARTNUTRI ENVIRONMENT CONFIGURATION

# 1. Google Gemini API Key (Dành cho Vision AI & Receipt OCR)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# 2. Cấu hình Cơ sở dữ liệu MySQL 8.0
# Mặc định backend chạy profile 'dev' (H2 in-memory) để test ngay không cần setup.
# Khi bạn muốn lưu dữ liệu bền vững vào MySQL, hãy đổi SPRING_PROFILES_ACTIVE=mysql
SPRING_PROFILES_ACTIVE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartnutri
DB_USERNAME=root
DB_PASSWORD=Cuong@592005
